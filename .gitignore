# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scripts with hardcoded credentials
/_*.js
/_*.ts
/_*.ps1
/deploy.ps1

# build/backup folders
/.next*/
/.build*/
/.deploy_build/
/.dist/
/.output/
/.production/
/_*/
/out_build/

# archives, logs, dumps
*.zip
*.tar.gz
*.txt
/out.json
